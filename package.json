{
  "name": "barzinho-filmes",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @barzinho/api\" \"npm run dev -w @barzinho/web\"",
    "dev:mobile": "npm run dev -w @barzinho/mobile",
    "build": "npm run build -w @barzinho/web",
    "start": "concurrently -k -n api,web \"npm run start -w @barzinho/api\" \"npm run start -w @barzinho/web\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm test && npm run build",
    "test:e2e": "playwright test",
    "dev:local": "node scripts/local.mjs",
    "start:local": "node scripts/local.mjs --built"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "tsx": "^4.21.0",
    "@types/node": "^24.10.0",
    "@playwright/test": "^1.58.2"
  }
}
