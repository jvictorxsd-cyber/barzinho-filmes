# API only; never expose TMDB tokens through NEXT_PUBLIC_* or EXPO_PUBLIC_*.
# Leave DATABASE_URL unset for persistent PGlite development database.
# DATABASE_URL=postgresql://barzinho:password@localhost:5432/barzinho
# TMDB_TOKEN=
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:4000
# Native devices must use a reachable server hostname, with HTTPS in production.
EXPO_PUBLIC_API_URL=http://localhost:4000
# Account e-mail delivery. Configure actual values securely; never commit credentials.
# SMTP_HOST=
SMTP_PORT=587
# SMTP_FROM=
# SMTP_USER=
# SMTP_PASSWORD=
# Public HTTPS origin used in e-mail links; local fallback is WEB_ORIGIN during development.
# PUBLIC_WEB_URL=
